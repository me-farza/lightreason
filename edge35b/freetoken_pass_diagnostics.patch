+"""Opt-in timing markers in a separate hybrid verifier graph."""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit(do_not_specialize=["layer"])
+def _stamp(stamps, fetched, misses, cpu_ids, layer, STAGE: tl.constexpr, ROUTES: tl.constexpr):
+    now = tl.inline_asm_elementwise(
+        "mov.u64 $0, %globaltimer;", constraints="=l", args=[], dtype=tl.int64,
+        is_pure=False, pack=1,
+    )
+    base = stamps + layer * 10
+    tl.store(base + STAGE, now)
+    if STAGE == 1:
+        ids = tl.load(cpu_ids + tl.arange(0, ROUTES))
+        tl.store(base + 7, tl.load(fetched))
+        tl.store(base + 8, tl.load(misses))
+        tl.store(base + 9, tl.sum((ids >= 0).to(tl.int64)))
+
+
+class ExpertTiming:
+    def __init__(self, layers, device):
+        self.device_stamps = torch.empty((layers, 10), dtype=torch.int64, device=device)
+        self.host_stamps = torch.empty((layers, 10), dtype=torch.int64, pin_memory=True)
+
+    def stamp(self, layer, stage, *, cache=None, cpu_ids=None):
+        if stage == 1:
+            fetched, misses = cache.num_indices, cache.num_missing_full
+            routes = cpu_ids.numel()
+            assert routes in (32, 64)
+        else:
+            fetched = misses = cpu_ids = self.device_stamps
+            routes = 1
+        _stamp[(1,)](self.device_stamps, fetched, misses, cpu_ids, layer, stage, routes, num_warps=1)
+
+    def copy_to_host(self):
+        self.host_stamps.copy_(self.device_stamps, non_blocking=True)
