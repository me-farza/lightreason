+def plan_selected_prefill(cache, layer_id: int, expert_ids: torch.Tensor) -> None:
+    selected = torch.zeros(cache.num_experts, dtype=torch.int32, device=cache.device)
+    ids = expert_ids.contiguous()
+    _mark_prefill_routes[(triton.cdiv(ids.numel(), 256),)](
+        ids, selected, ids.numel(), cache.num_experts, BLOCK=256,
+    )
+    _selected_prefill_indices[(1,)](
+        selected, cache.slot_for_id[layer_id], cache.evict_slots, cache.src_indices,
+        cache.num_indices, cache._prefill_hit_dst, cache._prefill_hit_src, cache._prefill_hit_num,
+        cache._selected_prefill_stats[layer_id], cache._pool_stable_from[0], cache.num_experts,
+        BLOCK=triton.next_power_of_2(cache.num_experts),
+    )
+
+
+@triton.jit
+def _mark_prefill_routes(ids, selected, count, num_experts, BLOCK: tl.constexpr):
+    i = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    expert = tl.load(ids + i, mask=i < count, other=-1)
+    tl.atomic_or(selected + expert, 1, mask=(expert >= 0) & (expert < num_experts), sem="relaxed")
+
+
+@triton.jit
+def _selected_prefill_indices(
+    selected, slots, cold_dst, cold_src, cold_count, hit_dst, hit_src, hit_count,
+    stats, stable_slot, num_experts, BLOCK: tl.constexpr,
+):
+    expert = tl.arange(0, BLOCK)
+    active = tl.load(selected + expert, mask=expert < num_experts, other=0) != 0
+    slot = tl.load(slots + expert, mask=expert < num_experts, other=-1)
+    hit = active & (slot >= stable_slot)
+    cold = active & ~hit
+    ci = tl.cumsum(cold.to(tl.int32)) - 1
+    hi = tl.cumsum(hit.to(tl.int32)) - 1
+    tl.store(cold_dst + ci, expert, mask=cold)
+    tl.store(cold_src + ci, expert, mask=cold)
+    tl.store(hit_dst + hi, expert, mask=hit)
+    tl.store(hit_src + hi, slot, mask=hit)
+    n_cold = tl.sum(cold.to(tl.int32))
+    n_hit = tl.sum(hit.to(tl.int32))
+    tl.store(cold_count, n_cold)
+    tl.store(hit_count, n_hit)
+    tl.store(stats, n_cold)
+    tl.store(stats + 1, n_hit)
 
 
