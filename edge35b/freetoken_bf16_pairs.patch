+      const __m256 wf = load_pair_f32(w + offset);
+      a0[j] = _mm256_fmadd_ps(wf, load_pair_f32(x0 + offset), a0[j]);
+      a1[j] = _mm256_fmadd_ps(wf, load_pair_f32(x1 + offset), a1[j]);
+    }
