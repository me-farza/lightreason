+@triton.jit
+def _resident_bf16_load(data, meta, raw, offsets):
+    if meta == 0:
+        values = tl.load(raw.to(tl.pointer_type(tl.uint16)) + offsets)
+    else:
+        tile = offsets // 256
+        i = offsets % 256
+        header = tl.load(meta.to(tl.pointer_type(tl.uint32)) + tile)
+        base = header & 255
+        address = data.to(tl.pointer_type(tl.uint8)) + tile * 384 + (header >> 8) * 128
+        fallback = base == 255
+        original = tl.load(address.to(tl.pointer_type(tl.uint16)) + i, mask=fallback, other=0)
+        low = tl.load(address + i, mask=~fallback, other=0).to(tl.uint16)
+        byte = tl.load(address + 256 + i // 2, mask=~fallback, other=0)
+        nibble = (byte >> ((i % 2) * 4)) & 15
+        high = (base + (nibble & 7)) | ((nibble & 8) << 4)
+        values = tl.where(fallback, original, low | (high.to(tl.uint16) << 8)).to(tl.uint16)
+    return values.to(tl.bfloat16, bitcast=True)
+
+
+@triton.jit
+def _resident_bf16_load_shared_header(data, meta, raw, output_rows, stride, k_start, k_index):
+    offsets = output_rows[None, :] * stride + k_start + k_index[:, None]
+    if meta == 0:
+        values = tl.load(raw.to(tl.pointer_type(tl.uint16)) + offsets)
+    else:
+        tile = (output_rows * stride + k_start) // 256
+        header = tl.load(meta.to(tl.pointer_type(tl.uint32)) + tile)
+        base = (header & 255)[None, :]
+        tile_address = data.to(tl.pointer_type(tl.uint8)) + tile * 384 + (header >> 8) * 128
+        address = tile_address[None, :]
+        i = ((k_start + k_index) % 256)[:, None]
+        fallback = base == 255
+        original = tl.load(address.to(tl.pointer_type(tl.uint16)) + i, mask=fallback, other=0)
+        low = tl.load(address + i, mask=~fallback, other=0).to(tl.uint16)
+        byte = tl.load(address + 256 + i // 2, mask=~fallback, other=0)
+        nibble = (byte >> ((i % 2) * 4)) & 15
+        high = (base + (nibble & 7)) | ((nibble & 8) << 4)
+        values = tl.where(fallback, original, low | (high.to(tl.uint16) << 8)).to(tl.uint16)
+    return values.to(tl.bfloat16, bitcast=True)
 
 
